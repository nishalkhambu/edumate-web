{
  "info": {
    "_postman_id": "edumate-api-collection",
    "name": "EduMate API Collection",
    "description": "Complete API documentation for EduMate backend. Contains all implemented endpoints for Authentication, Study Planner, Tasks, Notes, Goals, Analytics, Admin, and more.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo Student\",\n  \"email\": \"student@edumate.com\",\n  \"password\": \"Student@123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"student@edumate.com\",\n  \"password\": \"Student@123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Current User (Who Am I)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/whoami", "host": ["{{baseUrl}}"], "path": ["auth", "whoami"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Updated Name", "type": "text" },
                { "key": "email", "value": "updated@edumate.com", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/auth/update", "host": ["{{baseUrl}}"], "path": ["auth", "update"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "currentPassword", "value": "Student@123", "type": "text" },
                { "key": "newPassword", "value": "NewStudent@123", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/auth/update", "host": ["{{baseUrl}}"], "path": ["auth", "update"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"student@edumate.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"NewStudent@123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/reset-password/{{resetToken}}", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password", "{{resetToken}}"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "" },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Study Planner",
      "item": [
        {
          "name": "Create Study Plan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Midterm Prep\",\n  \"subject\": \"Mathematics\",\n  \"topic\": \"Calculus\",\n  \"deadline\": \"2026-08-15\",\n  \"studyHours\": 10,\n  \"priority\": \"high\",\n  \"progress\": 0\n}" },
            "url": { "raw": "{{baseUrl}}/study-plans", "host": ["{{baseUrl}}"], "path": ["study-plans"] }
          }
        },
        {
          "name": "Get Study Plans",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/study-plans", "host": ["{{baseUrl}}"], "path": ["study-plans"] }
          }
        },
        {
          "name": "Get Study Plan By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/study-plans/{{studyPlanId}}", "host": ["{{baseUrl}}"], "path": ["study-plans", "{{studyPlanId}}"] }
          }
        },
        {
          "name": "Update Study Plan",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated Prep\",\n  \"progress\": 50\n}" },
            "url": { "raw": "{{baseUrl}}/study-plans/{{studyPlanId}}", "host": ["{{baseUrl}}"], "path": ["study-plans", "{{studyPlanId}}"] }
          }
        },
        {
          "name": "Delete Study Plan",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/study-plans/{{studyPlanId}}", "host": ["{{baseUrl}}"], "path": ["study-plans", "{{studyPlanId}}"] }
          }
        }
      ]
    },
